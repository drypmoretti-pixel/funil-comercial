  {
   "parameters": {
    "jsCode": "const payment = $('Criar Cobranca na Asaas').first().json;\nconst pricing = $('Calcular Preco (Tabela B)').first().json;\n\nconst fmt = (n) => Number(n).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\nconst message = `Link de pagamento gerado.\\n`\n  + `Sinal: R$ ${fmt(pricing.deposit_amount)}\\n`\n  + `Restante (pago na clinica): R$ ${fmt(pricing.remaining_amount)}\\n`\n  + `Link: ${payment.invoiceUrl}`;\n\nreturn [{ json: { output: message, invoice_url: payment.invoiceUrl, deposit_amount: pricing.deposit_amount, remaining_amount: pricing.remaining_amount } }];"
   },
