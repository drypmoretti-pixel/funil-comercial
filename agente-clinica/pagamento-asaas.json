  {
   "parameters": {
    "jsCode": "// EXEMPLO: troque cidades, especialidades e valores pelos da sua clínica.\n// price = valor da consulta · deposit = fração cobrada como sinal (0.2 = 20%)\nconst PRICING = {\n  SPECIALTY_A: {\n    CIDADE_1: { FIRST: { price: 300, deposit: 0.2 }, RETURN: { price: 250, deposit: 0.2 } },\n    CIDADE_2: { FIRST: { price: 350, deposit: 0.5 }, RETURN: { price: 300, deposit: 0.5 } },\n    CIDADE_3: { SINGLE: { price: 250, deposit: 0.5 } }\n  },\n  GP: { ANY: { SINGLE: { price: 200, deposit: 0.2 } } }\n};\nconst trigger = $('Recebe Dados de Pagamento').first().json;\n\nlet clientInfo = null;\nfor (const name of ['Marcar Cliente Existente', 'Marcar Cliente Novo', 'Marcar Cliente Preenchido']) {\n  try {\n    const results = $(name).all();\n    if (results && results.length > 0) { clientInfo = results[0].json; break; }\n  } catch (e) {}\n}\nif (!clientInfo) { throw new Error('Nao foi possivel resolver os dados do cliente (nenhum dos 3 nos de resolucao rodou)'); }\n\nconst city = String(trigger.consulting_city || '').toUpperCase();\nconst specialty = String(trigger.specialty || '').toUpperCase();\nconst existingCustomer = !!clientInfo.existing_customer;\nconst consultationType = existingCustomer ? 'RETURN' : 'FIRST';\n\nlet config;\nif (specialty === 'SPECIALTY_A') {\n  if (city === 'CIDADE_3') config = PRICING.SPECIALTY_A.CIDADE_3.SINGLE;\n  else config = (PRICING.SPECIALTY_A[city] || {})[consultationType];\n} else {\n  config = PRICING.GP.ANY.SINGLE;\n}\n\nif (!config) {\n  throw new Error(`Tabela de preco nao encontrada para specialty=${specialty} city=${city}`);\n}\n\nconst depositAmount = Math.round(config.price * config.deposit * 100) / 100;\n\nreturn [{ json: {\n  asaas_customer_id: clientInfo.asaas_customer_id,\n  city, specialty, consultationType,\n  total_price: config.price,\n  deposit_percentage: config.deposit,\n  deposit_amount: depositAmount,\n  remaining_amount: config.price - depositAmount,\n  billing_type: trigger.billing_type,\n  cpf_cnpj: trigger.cpf_cnpj,\n  phone: trigger.phone\n} }];"
   },
