   "id": "cal-getslots-0001",
   "name": "Buscar Horarios",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    -2112,
    16
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "",
     "name": "Cal.com API"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const body = $json.data || {};\nconst dates = Object.keys(body);\nif (dates.length === 0) {\n  return [{ json: { output: 'Nenhum horario disponivel nesse dia.', slots: [] } }];\n}\n\nconst periods = { manha: [], tarde: [], noite: [] };\nconst allSlots = [];\nfor (const date of dates) {\n  for (const slot of body[date]) {\n    const hour = Number(slot.start.slice(11,13));\n    allSlots.push(slot.start);\n    if (hour < 12) periods.manha.push(slot.start);\n    else if (hour < 17) periods.tarde.push(slot.start);\n    else periods.noite.push(slot.start);\n  }\n}\n\nconst fmt = (iso) => iso.slice(11,16);\nlet lines = [];\nif (periods.manha.length) lines.push('Manha: ' + periods.manha.slice(0,3).map(fmt).join(', '));\nif (periods.tarde.length) lines.push('Tarde: ' + periods.tarde.slice(0,3).map(fmt).join(', '));\nif (periods.noite.length) lines.push('Noite: ' + periods.noite.slice(0,3).map(fmt).join(', '));\n\nconst output = lines.join('\\n');\nreturn [{ json: { output, slots: allSlots.slice(0,9) } }];"
   },
